# Copy to scripts/.env.setup and fill in. Never commit .env.setup.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=Skill Guide
APPWRITE_DATABASE_NAME=Skill Guide
APPWRITE_BUCKET_ID=resumes
APPWRITE_BUCKET_NAME=Resumes

# Internship importer (defaults shown)
SOURCE=file             # file (JSON feed) or remotive (API)
FEED_FILE=              # path to the JSON feed (default: scripts/feeds/internships.json)
INTERNSHIP_TTL_DAYS=30  # how long imported listings stay visible before auto-expiring
IMPORT_MAX=50           # max openings imported per run