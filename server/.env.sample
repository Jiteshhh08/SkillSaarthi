# ============================================================
# Node.js Backend (server/.env — NEVER expose these to the browser)
# Copy this file to .env and fill in the values.
# ============================================================
PORT=5000

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_RESUME_BUCKET_ID=resumes

# Python AI service
AI_SERVICE_URL=http://localhost:8000

# External services
GITHUB_TOKEN=
LLM_API_KEY=

# Email — Resend HTTPS (preferred on Render, not blocked like SMTP) or SMTP fallback
# Get Resend API key at https://resend.com/api-keys, verify sender domain, then set:
RESEND_API_KEY=
RESEND_FROM=skillsaarthi <skillsaarthi.support@gmail.com>
# SMTP fallback (local dev with Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=skillsaarthi.support@gmail.com
EMAIL_PASS=YOUR_16_CHAR_APP_PASSWORD
EMAIL_FROM=skillsaarthi <skillsaarthi.support@gmail.com>
FRONTEND_URL=http://localhost:5173