# ============================================================
# Node.js Backend (server/.env — NEVER expose these to the browser)
# Copy this file to .env and fill in the values.
# ============================================================
PORT=5000

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_RESUME_BUCKET_ID=resumes

# Python AI service
AI_SERVICE_URL=http://localhost:8000

# External services
GITHUB_TOKEN=
LLM_API_KEY=

# Email — SendGrid HTTPS (preferred on Render - Single Sender, no domain needed)
# Free 100/day — create at https://app.sendgrid.com, verify Single Sender at https://app.sendgrid.com/settings/sender_auth/senders (Gmail works, click validation email)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_SENDER=skillsaarthi <skillsaarthi.support@gmail.com>
# SMTP fallback (local dev with Gmail App Password) — ignored when SENDGRID_API_KEY is set
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=skillsaarthi.support@gmail.com
EMAIL_PASS=YOUR_16_CHAR_APP_PASSWORD
EMAIL_FROM=skillsaarthi <skillsaarthi.support@gmail.com>
FRONTEND_URL=http://localhost:5173