# ============================================================
# Node.js Backend (server/.env — NEVER expose these to the browser)
# Copy this file to .env and fill in the values.
# ============================================================
PORT=5000

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_RESUME_BUCKET_ID=resumes

# Python AI service
AI_SERVICE_URL=http://localhost:8000

# External services
GITHUB_TOKEN=
LLM_API_KEY=

# Email — Mailjet HTTPS (preferred on Render - not blocked like SMTP, no domain needed) or SMTP fallback
# Get Mailjet keys at https://app.mailjet.com/account/api_keys (free 200/day, 6000/mo)
# Verify sender at https://app.mailjet.com/account/sender (Gmail works, no domain needed - click validation email)
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAILJET_SENDER=skillsaarthi <skillsaarthi.support@gmail.com>
# SMTP fallback (local dev with Gmail App Password) — ignored when MAILJET_API_KEY is set
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=skillsaarthi.support@gmail.com
EMAIL_PASS=YOUR_16_CHAR_APP_PASSWORD
EMAIL_FROM=skillsaarthi <skillsaarthi.support@gmail.com>
FRONTEND_URL=http://localhost:5173