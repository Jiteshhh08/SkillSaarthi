# ============================================================
# Python AI Service (ai-service/.env)
# Copy this file to .env and fill in the values.
# ============================================================
PORT=8000

# TCET CoE AI Gateway (OpenAI-compatible). Server-side only — never exposed
# to the frontend. AI_KEY is preferred; LLM_API_KEY is kept as a legacy alias.
AI_BASE_URL=https://ai.tcetcercd.in/v1
AI_MODEL=Qwen3.6-35B-A3B
AI_KEY=
LLM_API_KEY=

# Optional tuning (keep the defaults unless you know better):
# AI_TIMEOUT_SECONDS=120
# AI_MAX_RETRIES=2
# LATEX_COMPILE_TIMEOUT=300