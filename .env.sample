# ============================================================
# Frontend (client-safe — prefix VITE_ is exposed to the browser)
# Copy this file to .env and fill in the values.
# ============================================================
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_PROJECT_NAME =
VITE_APPWRITE_RESUME_BUCKET_ID=

# Node.js backend URL (used by the frontend for business-logic APIs)
VITE_API_BASE_URL=http://localhost:5000

# ============================================================
# Node.js Backend (server/.env — NEVER expose these to the browser)
# ============================================================
PORT=5000

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

# Python AI service
AI_SERVICE_URL=http://localhost:8000

# External services
GITHUB_TOKEN=
LLM_API_KEY=

# ============================================================
# Python AI Service (ai-service/.env)
# ============================================================
PORT=8000
LLM_API_KEY=
